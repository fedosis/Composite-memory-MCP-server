          "query": {
            "type": "string",
            "description": "Natural language query text"
          },
          "top_k": {
            "type": "integer",
            "description": "Maximum number of results (default 10)",
            "default": 10
          },
          "score_threshold": {
            "type": "number",
            "description": "Minimum similarity score 0.0-1.0 (default 0.0)",
            "default": 0.0
          }
        },
        "required": []
      }
    },
    {
      "name": "graph_search",
