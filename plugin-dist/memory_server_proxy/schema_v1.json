          },
          "target_id": {
            "type": "string",
            "description": "Target entity for pathfinding"
          }
        },
        "required": []
      }
    },
    {
      "name": "route",
      "description": "Route query through 4-stage router (rules->embeddings->graph->LLM) per ADR-005",
