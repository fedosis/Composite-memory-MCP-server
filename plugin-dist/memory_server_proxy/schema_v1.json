    {
      "name": "reflect",
      "description": "Analyse belief store (overview, contradictions, decay, topics, audit, confidence)",
      "parameters": {
        "type": "object",
        "properties": {
          "mode": {
            "type": "string",
            "description": "Mode: overview, contradictions, decay, topics, audit, or confidence",
            "default": "overview",
            "enum": [
              "overview",
              "contradictions",
              "decay",
              "topics",
              "evidence_audit",
              "confidence"
