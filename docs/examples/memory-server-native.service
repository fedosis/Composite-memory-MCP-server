[Unit]
Description=CMMS native memory service
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/env python -m memory_server.cli native-serve --config /srv/cmms/service.json
WorkingDirectory=/srv/cmms
EnvironmentFile=/etc/cmms/native.env
Restart=on-failure
RestartPreventExitStatus=3
KillSignal=SIGTERM
TimeoutStopSec=45
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
RuntimeDirectory=cmms-native
RuntimeDirectoryMode=0700
ReadWritePaths=/srv/cmms/store /run/cmms-native
# AF_INET/AF_INET6 are required for extraction_mode=llm (LLM egress over https).
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
